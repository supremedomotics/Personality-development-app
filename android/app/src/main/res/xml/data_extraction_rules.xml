<?xml version="1.0" encoding="utf-8"?>
<!-- Training data (transcripts, scores, reflections) must never leave the device
     through OS cloud backup or device-to-device transfer. Moving it to a new
     phone is done through the app's own explicit, encrypted export (planned). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
